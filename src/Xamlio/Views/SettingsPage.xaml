<Page
    x:Class="Xamlio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer
            Padding="8"
            IsTabStop="False"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled"
            XYFocusKeyboardNavigation="Enabled">

            <StackPanel
                MaxWidth="900"
                HorizontalAlignment="Left"
                Spacing="10"
                XYFocusKeyboardNavigation="Enabled">

                <TextBlock
                    Text="Stremio account"
                    Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel
                    x:Name="LoginPanel"
                    Spacing="10">

                    <TextBox
                        x:Name="Email"
                        Header="Email"
                        InputScope="EmailSmtpAddress"
                        Width="500"
                        HorizontalAlignment="Left" />

                    <PasswordBox
                        x:Name="Password"
                        Header="Password"
                        Width="500"
                        HorizontalAlignment="Left" />

                    <Button
                        x:Name="LoginButton"
                        Content="Log in"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Login_Click" />

                    <Button
                        x:Name="QrLoginButton"
                        Content="Log in with QR code"
                        Click="QrLogin_Click" />
                </StackPanel>

                <StackPanel
                    x:Name="QrLoginPanel"
                    Visibility="Collapsed"
                    Spacing="8">

                    <TextBlock
                        Text="QR code login"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Image
                        x:Name="QrCodeImage"
                        Width="360"
                        Height="360"
                        Stretch="Uniform"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        x:Name="QrCodeText"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="QrLoginStatus"
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="600" />

                    <Button
                        Content="Cancel QR login"
                        Click="CancelQrLogin_Click" />
                </StackPanel>

                <StackPanel
                    x:Name="AccountPanel"
                    Orientation="Horizontal"
                    Spacing="16"
                    Visibility="Collapsed">

                    <TextBlock
                        x:Name="AccountText"
                        VerticalAlignment="Center" />

                    <Button
                        Content="Log out"
                        Click="Logout_Click" />
                </StackPanel>

                <TextBlock
                    x:Name="AccountStatus"
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Text="Playback"
                    Style="{StaticResource SectionHeaderStyle}" />

                <TextBox
                    x:Name="ServerUrl"
                    Header="Streaming server (optional, for torrent streams)"
                    PlaceholderText="http://192.168.1.20:11470"
                    Width="500"
                    HorizontalAlignment="Left"
                    InputScope="Url"
                    LostFocus="ServerUrl_LostFocus" />

                <TextBlock
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="Torrents need the Stremio streaming server running on another device on your network. Debrid and direct links play without it." />

                <TextBox
                    x:Name="BackgroundImageUrlTemplate"
                    Header="Background image server URL template (optional)"
                    PlaceholderText="https://example.com/images/{id}.jpg"
                    Width="600"
                    HorizontalAlignment="Left"
                    InputScope="Url"
                    LostFocus="BackgroundImageUrlTemplate_LostFocus" />

                <TextBlock
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="Use {id} for the media ID. Leave blank to use the artwork supplied by the metadata addon. A custom server or proxy must provide the image and handle any provider authentication." />

                <PasswordBox
                    x:Name="TmdbApiKey"
                    Header="TMDB API key (optional)"
                    Width="600"
                    HorizontalAlignment="Left"
                    LostFocus="TmdbApiKey_LostFocus" />

                <TextBlock
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap"
                    Text="When set, TMDB supplies show and movie backgrounds using the IMDb ID. Leave blank to use the metadata addon artwork." />

                <ToggleSwitch
                    x:Name="UseEpisodeArtworkAsBackground"
                    Header="Use selected episode artwork as background"
                    Toggled="UseEpisodeArtworkAsBackground_Toggled" />

                <ComboBox
                    x:Name="SubtitleLang"
                    Header="Preferred subtitle language"
                    Width="300"
                    SelectionChanged="SubtitleLang_SelectionChanged" />

                <ComboBox
                    x:Name="AudioLang"
                    Header="Preferred audio language"
                    Width="300"
                    SelectionChanged="AudioLang_SelectionChanged" />

                <ToggleSwitch
                    x:Name="SubtitlesEnabled"
                    Header="Enable preferred subtitles by default"
                    Toggled="SubtitlesEnabled_Toggled" />

                <ToggleSwitch
                    x:Name="PreferSignsAndSongs"
                    Header="Prefer signs and songs subtitles"
                    Toggled="PreferSignsAndSongs_Toggled" />

                <ToggleSwitch
                    x:Name="Passthrough"
                    Header="Audio passthrough (Dolby/DTS to TV or receiver)"
                    Toggled="Passthrough_Toggled" />

                <ToggleSwitch
                    x:Name="MatchDisplay"
                    Header="Match display mode (4K / HDR10 / frame rate)"
                    Toggled="MatchDisplay_Toggled" />

                <ToggleSwitch
                    x:Name="TvSafeMarginsToggle"
                    Header="Use TV-safe margins"
                    Toggled="TvSafeMarginsToggle_Toggled" />

                <TextBlock
                    Text="Addons"
                    Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <TextBox
                        x:Name="AddonUrl"
                        PlaceholderText="https://example.com/manifest.json"
                        Width="600"
                        InputScope="Url" />

                    <Button
                        Content="Add"
                        Click="AddAddon_Click" />
                </StackPanel>

                <TextBlock
                    x:Name="AddonStatus"
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="AddonList"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    IsTabStop="False">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Padding="0,4">

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
