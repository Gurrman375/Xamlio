<Page
    x:Class="Xamlio.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock
                Text="Release calendar"
                FontSize="30"
                FontWeight="SemiBold" />

            <TextBlock
                x:Name="RangeTitle"
                HorizontalAlignment="Right"
                Margin="0,4,12,0"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="18" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,14,0,12">
            <Button Content="Previous" Click="Previous_Click" IsTabStop="True" />
            <Button Content="Today" Click="Today_Click" IsTabStop="True" />
            <Button Content="Next" Click="Next_Click" IsTabStop="True" />
            <Button x:Name="MonthButton" Content="Month" Click="Month_Click" IsTabStop="True" />
            <Button x:Name="WeekButton" Content="Week" Click="Week_Click" IsTabStop="True" />
            <Button x:Name="DayButton" Content="Day" Click="Day_Click" IsTabStop="True" />
        </StackPanel>

        <Grid
            x:Name="WeekdayHeader"
            Grid.Row="2"
            Margin="0,0,0,6"
            Height="32" />

        <Grid Grid.Row="3">
            <Grid x:Name="CalendarGrid" />

            <ScrollViewer
                x:Name="DayScroll"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Hidden"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DayList" Spacing="8" />
            </ScrollViewer>

            <TextBlock
                x:Name="EmptyMessage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="700"
                Foreground="{StaticResource MutedTextBrush}"
                Text="No saved release reminders in this period."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
